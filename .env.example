# Optional local settings. Copy to .env; shell environment variables take precedence.
HOST=0.0.0.0
PORT=3000
# Campaign-memory retrieval is enabled by default. Set to 0 for new turns to use only recent context.
# GATHER_CAMPAIGN_MEMORY=0
# Optional local character/NPC portraits and item/ability icons (no image API fees).
# Run npm run icons:setup and npm run build once. Then npm start runs Gather and the icon service.
# For npm run dev, start npm run icons separately. Character text and gameplay use ChatGPT.
# GATHER_ICON_URL=http://127.0.0.1:7861
# For WSL, use the Windows laptop's LAN address after enabling port forwarding:
# GATHER_PUBLIC_URL=http://192.168.1.10:3000
# With the router resolving gather and LAN port 80 forwarded to Gather's port 3000:
# GATHER_PUBLIC_URL=http://gather

# Google player sign-in. Register this exact callback in a Google OAuth Web client.
# Phones require a reachable HTTPS domain forwarding to this same Gather server.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://your-gather-domain.example/auth/google/callback
# GOOGLE_CALLBACK_PORT=3001
# NGROK_AUTHTOKEN=your-ngrok-account-token
# After starting Gather, run: npm run tunnel
# Tunnel only this callback listener (3001); gameplay and ChatGPT stay on the LAN server (3000).
