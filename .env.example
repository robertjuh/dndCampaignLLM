# Optional local settings. Copy to .env; shell environment variables take precedence.
HOST=0.0.0.0
PORT=3000
# For WSL, use the Windows laptop's LAN address after enabling port forwarding:
# GATHER_PUBLIC_URL=http://192.168.1.10:3000

# Google player sign-in. Register this exact callback in a Google OAuth Web client.
# Phones require a reachable HTTPS domain forwarding to this same Gather server.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://your-gather-domain.example/auth/google/callback
# GOOGLE_CALLBACK_PORT=3001
# NGROK_AUTHTOKEN=your-ngrok-account-token
# After starting Gather, run: npm run tunnel
# Tunnel only this callback listener (3001); gameplay and ChatGPT stay on the LAN server (3000).
